# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Public URL of the deployed site (used for sitemap, Open Graph and structured data)
NEXT_PUBLIC_SITE_URL=http://rajmomaitransport.in

# --- Email enquiries (Resend: https://resend.com) ---
# API key from the Resend dashboard. Server-side only (no NEXT_PUBLIC_ prefix).
RESEND_API_KEY=

# Where enquiries are delivered
ENQUIRY_TO_EMAIL=Mandeep210405@gmail.com

# Sender address. Must be on a domain verified in Resend.
# For quick testing you can use: Rajmomai Transport <onboarding@resend.dev>
# (Resend only delivers test mail to the email address of your own Resend account.)
ENQUIRY_FROM_EMAIL=Rajmomai Transport <onboarding@resend.dev>
